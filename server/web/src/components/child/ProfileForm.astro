---
/** A gyerek azonossága: név és iskola. Ez a lap teteje, a két csatlakozó fölött.
 *  Ugyanez az űrlap fogadja az új gyereket és szerkeszti a meglévőt. */
---

<section class="profile" id="child-profile" aria-labelledby="profile-form-title">
  <h2 id="profile-form-title">A gyerek adatai</h2>
  <p id="profile-form-intro">A profil a te Google-fiókodhoz tartozik. Jelszót itt nem kérünk.</p>

  <form id="profile-form" novalidate>
    <label class="field" for="child-name">
      <span class="field-label">A gyerek neve</span>
      <span class="field-help">Claude-nak ezen a néven hivatkozhatsz rá. Ennyi elég ahhoz, hogy a gyerek létrejöjjön.</span>
      <input id="child-name" name="childName" type="text" minlength="2" maxlength="80" autocomplete="off" required placeholder="pl. Lilla" />
    </label>

    <label class="field" for="institute-code">
      <span class="field-label">Iskola <em>nem kötelező</em></span>
      <span class="field-help" id="institute-help">A KRÉTA-naplóhoz kell; a Classroomhoz nem. Írj be legalább 3 karaktert az iskola nevéből vagy kódjából, majd válassz a találatok közül. A kód kézzel is megadható.</span>
      <input id="institute-code" name="instituteCode" type="text" maxlength="200" autocomplete="off" autocapitalize="none" spellcheck="false" list="institute-options" aria-describedby="institute-help institute-search-status" aria-busy="false" placeholder="pl. Budenz vagy klik034802001" />
    </label>
    <datalist id="institute-options"></datalist>
    <p class="institute-status" id="institute-search-status" role="status" aria-live="polite"></p>

    <div class="form-actions">
      <button class="save-profile" id="save-profile" type="submit">Gyerek mentése</button>
      <button class="cancel-profile" id="cancel-profile" type="button">Mégse</button>
    </div>
  </form>
</section>

<style>
  .profile { padding: 1.1rem 0 1.4rem; }
  h2 { margin: 0; color: var(--blue); font-size: .95rem; letter-spacing: -.025em; }
  #profile-form-intro { max-width: 44rem; margin: .35rem 0 .5rem; color: var(--ink-muted); font-size: .8rem; line-height: 1.55; }

  /* Ugyanaz a kétoszlopos rács, mint a fülek nézetsoraiban: bal oldalt a
     megnevezés, jobb oldalt az érték — csak most szerkeszthető. */
  .field {
    display: grid;
    grid-template-columns: minmax(10rem, .7fr) minmax(0, 1fr);
    column-gap: 1.5rem;
    max-width: 46rem;
    padding: .8rem 0;
    border-bottom: 1px solid var(--blue-soft);
    color: var(--ink);
    font-size: .85rem;
    font-weight: 800;
  }

  .field-label { grid-column: 1; align-self: start; }
  .field-label em { color: var(--ink-muted); font-size: .74rem; font-style: normal; font-weight: 500; }
  .field-help { grid-column: 1; margin-top: .3rem; color: var(--ink-muted); font-size: .74rem; font-weight: 450; line-height: 1.5; }
  .field input { grid-column: 2; grid-row: 1 / span 2; align-self: start; }

  input:not([type="checkbox"]):not([type="radio"]) {
    width: 100%;
    min-height: 3rem;
    padding: 0 .8rem;
    border: 1px solid #8799af;
    border-radius: 0;
    color: var(--ink);
    background: var(--paper-bright);
    caret-color: var(--blue);
  }

  .institute-status { max-width: 46rem; min-height: 1.2rem; margin: .5rem 0 0; color: var(--ink-muted); font-size: .78rem; line-height: 1.5; }
  .institute-status[data-kind="error"] { color: #a62f22; }

  .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: 1.1rem; }

  .save-profile {
    min-height: 3.1rem;
    padding: .7rem 1.4rem;
    border: 2px solid var(--blue-strong);
    border-radius: 0;
    color: white;
    background: var(--blue-strong);
    font-size: .85rem;
    font-weight: 800;
    cursor: pointer;
  }

  .save-profile:hover { background: var(--blue); }
  .save-profile:disabled { cursor: wait; opacity: .6; }

  .cancel-profile {
    min-height: 3.1rem;
    padding: .7rem 1rem;
    border: 0;
    color: var(--blue);
    background: transparent;
    font-size: .8rem;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: .25rem;
    cursor: pointer;
  }

  @media (max-width: 620px) {
    .field { grid-template-columns: 1fr; }
    .field input { grid-column: 1; grid-row: auto; margin-top: .5rem; }
  }

  @media (max-width: 560px) {
    .form-actions { align-items: stretch; flex-direction: column; }
    .save-profile, .cancel-profile { width: 100%; }
  }
</style>
